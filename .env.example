# PythonAnywhere MySQL — get these from the Databases tab
DATABASE_URL=mysql+pymysql://username:password@username.mysql.pythonanywhere-services.com/username$inventory_management?charset=utf8mb4

# Admin login password (change this!)
ADMIN_PASSWORD=your-strong-password

# Session secret — generate once, then pin it so sessions survive restarts
SESSION_SECRET=generate-a-random-hex-string-here
